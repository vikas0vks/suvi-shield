{
  "name": "suvi-shield",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first ad, tracker, popup and privacy firewall for Chromium browsers.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:clean": "node scripts/build.mjs --clean",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run validate",
    "dev": "node scripts/build.mjs --watch",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "package": "node scripts/package.mjs",
    "rules:update": "node scripts/compile-rules.mjs",
    "rules:starter": "node scripts/compile-rules.mjs --starter",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-build.mjs",
    "validate:release": "node scripts/validate-build.mjs --release"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/chrome": "^0.1.2",
    "@types/node": "^24.5.2",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.1"
  }
}
